{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpptlm.local/schemas/protocol_instance.schema.json",
  "title": "CEP 协议实例能力声明",
  "description": "Coherence Exploration Platform 的协议实例声明 schema —— per ADR-CEP-12 §2 决策 1(8 字段组)+ ADR-CEP-11 §3(规范版本锁定表)+ ADR-CEP-14 §2(负向断言的载体)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "adapter",
    "status",
    "protocol_version",
    "flow_support",
    "perm",
    "atomic",
    "consistency_labels",
    "ordering_assumption",
    "vc_binding",
    "sharer_tracker",
    "combination_capabilities"
  ],
  "properties": {
    "id": {
      "description": "协议实例的稳定身份(计数与交叉引用依赖)",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "family": {
      "description": "来源族(per 07 号 §5.1 口径:族 = 来源集合)",
      "enum": [
        "industrial",
        "ruby-slicc",
        "academic"
      ]
    },
    "adapter": {
      "description": "1 协议实例 = 1 adapter",
      "type": "string",
      "minLength": 1
    },
    "status": {
      "description": "计数口径的唯一依据:仅 implemented 计入 adapter 实例数",
      "enum": [
        "planned",
        "implemented",
        "excluded"
      ]
    },
    "protocol_version": {
      "description": "规范版本(per ADR-CEP-11 §3 锁定表);adapter 实现版本由 git 承载,不入本 schema",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9.]+)*$"
    },
    "flow_support": {
      "description": "canonical 10 流覆盖矩阵(per ADR-CEP-02 §2)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "completion",
        "snoop",
        "snoop_resp",
        "writeback",
        "forward_data",
        "back_invalidate",
        "address_resolve",
        "barrier",
        "snoop_completion_ack"
      ],
      "properties": {
        "request": {
          "type": "boolean"
        },
        "completion": {
          "type": "boolean"
        },
        "snoop": {
          "type": "boolean"
        },
        "snoop_resp": {
          "type": "boolean"
        },
        "writeback": {
          "type": "boolean"
        },
        "forward_data": {
          "type": "boolean"
        },
        "back_invalidate": {
          "type": "boolean"
        },
        "address_resolve": {
          "type": "boolean"
        },
        "barrier": {
          "type": "boolean"
        },
        "snoop_completion_ack": {
          "type": "boolean"
        }
      }
    },
    "perm": {
      "description": "Stub Cache 权限枚举 —— 4 值锁(per ADR-CEP-02 CEN-Ib11)指**取值域恰 4 值**(NONE/READ/UNIQUE/WRITEBACK);不新增 ATOMIC 值;**每个实例可声明其中子集**(由 minItems=1 + uniqueItems 表达 —— 域锁 ≠ 每实例全列)",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NONE",
          "READ",
          "UNIQUE",
          "WRITEBACK"
        ]
      }
    },
    "atomic": {
      "description": "atomic 意图的承载(per ADR-CEP-17 决策 6):语义归插件,意图经 request 流独立属性传递",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "intent_field": {
          "description": "request 流中承载 atomic 意图的属性名",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "consistency_labels": {
      "description": "一致性标签(per HeteroGen §II-B / 博士论文 §7.6.6)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write"
      ],
      "properties": {
        "read": {
          "enum": [
            "SC",
            "TSO",
            "RC-acquire",
            "RC-data",
            "PLO"
          ]
        },
        "write": {
          "enum": [
            "SC",
            "TSO",
            "RC-release",
            "RC-data",
            "PLO"
          ]
        },
        "request_level": {
          "description": "请求级标签映射 —— 同一 wire 请求在不同标签下语义不同(如 RCC 的 GetV_R / GetV_A)",
          "type": "object",
          "additionalProperties": {
            "enum": [
              "SC",
              "TSO",
              "RC-acquire",
              "RC-data",
              "RC-release",
              "PLO"
            ]
          }
        }
      }
    },
    "ordering_assumption": {
      "description": "逐网络 × 逐 VC 的排序假设(per ADR-CEP-12 决策 5 修订 + ArchForge 32 号 N-2 裁决选项 A):key = network,值 = { vc_id: ordering };排序是协议对所用 (network, vc_id) 的保序需求 + fabric 侧担保,一致性由装配期校验承担(per INV-CEP-12-IC2);排序是 VC 的静态属性,flit 不带 ordering 字段",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[0-9]+$"
        },
        "additionalProperties": {
          "enum": [
            "p2p_ordered",
            "unordered"
          ]
        }
      }
    },
    "vc_binding": {
      "description": "逐网络的消息类 → vc_id 映射(per ADR-CEP-12 决策 6 修订 + ArchForge 32 号 N-2 裁决选项 A:VC 分配是 per-network 的,死锁自由论证的图节点必须是 (network, vc_id));消息类词表 = 6 类 {request,response,snoop,snoop_resp,atomic,query}(per ArchForge 32 号 §6.0.1;排除 CATEGORY_CREDIT 流控类别 / forward_data 流 6 / snoop_completion_ack 流 10 —— 后两者是已有槽位的承载实例,不单列);不自动生成",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "enum": [
            "request",
            "response",
            "snoop",
            "snoop_resp",
            "atomic",
            "query"
          ]
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "sharer_tracker": {
      "description": "逐实例 Sharer Tracker 选型(per ADR-CEP-04 §2 5 实现 + caps descriptor)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impl",
        "caps"
      ],
      "properties": {
        "impl": {
          "description": "5 实现之一,或字面值「不参与」(由副本携带权限的协议 / 自失效类协议)",
          "enum": [
            "FullMapDirectory",
            "SparseSnoopFilter",
            "DcohSymmetric",
            "TreeManager",
            "BroadcastNull",
            "不参与",
            "HierarchicalDirectory"
          ]
        },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "completeness",
            "authority",
            "aggregation_at"
          ],
          "properties": {
            "scope": {
              "enum": [
                "SYSTEM",
                "LOCAL_MEMORY_REGION",
                "SUBTREE",
                "NONE"
              ]
            },
            "completeness": {
              "enum": [
                "EXACT",
                "CONSERVATIVE"
              ]
            },
            "authority": {
              "enum": [
                "GLOBAL",
                "LOCAL_HINT",
                "LOCAL",
                "NONE"
              ]
            },
            "aggregation_at": {
              "enum": [
                "HOME",
                "REQUESTER",
                "TREE_PARENT",
                "NONE",
                "HIERARCHICAL"
              ]
            }
          }
        }
      }
    },
    "combination_capabilities": {
      "description": "组合能力(per 调研 F16):三维正交,且正交于 family",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrent",
        "hierarchical",
        "heterogeneous"
      ],
      "properties": {
        "concurrent": {
          "type": "boolean"
        },
        "hierarchical": {
          "type": "boolean"
        },
        "heterogeneous": {
          "type": "boolean"
        }
      }
    },
    "combination_contract": {
      "description": "组合契约(per ADR-CEP-12 Status Update 2026-11-21):① bridging = 跨域桥接行为契约 ② compound_consistency = 复合一致性判据的实例化声明。⛔ 本属性为**可选**(不进 required);⛔ 边类语义不在本仓定义(见 ADR-CEP-13 决策 2)",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "bridging": {
          "description": "跨域桥接行为契约(per ADR-CEP-13 决策 4:并发粒度由对端协议是否允许提前 ack 决定)。⚠️ 消费方向:桥 A↔B 的并发粒度读 **B**(对端)实例的 `early_ack`",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "required": [
            "early_ack"
          ],
          "properties": {
            "early_ack": {
              "description": "对端协议是否允许提前 ack(枚举前两项与 ADR-CEP-13 决策 4 表的两行「允许提前写 ack」/「不允许提前完成」**语义逐字对应**,kebab-case 转写;⛔ 非 ADR 原文的英文直译)。⛔ `unknown` = 无一手协议锚点时的**显式**声明(⛔ 不得编值);⛔ 本仓**无**「本实例是否参与跨域桥接」的判定面 ⇒ 该事实暂由 `unknown` 覆盖(见 ADR-CEP-12 Status Update 2026-11-21 的 P-9 说明)",
              "enum": [
                "allow-early-write-ack",
                "deny-early-completion",
                "unknown"
              ]
            }
          }
        },
        "compound_consistency": {
          "description": "复合一致性判据的实例化声明(per ADR-CEP-13 决策 2 + 决策 5 ①)。⛔ 本项只登记**取值域**与**可验范围**;⛔ 边类语义锚点 = ADR-CEP-13 决策 2(⛔ 本仓不复述、不重定义)",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "required": [
            "adopted"
          ],
          "properties": {
            "adopted": {
              "type": "boolean",
              "description": "本实例参与的组合是否采用复合一致性判据"
            },
            "edge_classes": {
              "type": "array",
              "description": "判据在跨域关系上使用的边类取值域(⛔ 取值域 ≠ 语义定义)",
              "items": {
                "enum": [
                  "rfe",
                  "fr",
                  "ws"
                ]
              }
            },
            "verification_scope": {
              "type": "string",
              "minLength": 1,
              "description": "域内可验范围(per ADR-CEP-13 决策 5 ②:平台只尝试证伪,不提供无违例保证)"
            }
          }
        }
      }
    }
  }
}
