{
  "name": "dgpu_board_v1",
  "description": "CppTLM dGPU board topology — 23 ABI 默认入口配置 (per cpptlm_emulator_create(dev_id=0) implicit fallback, per test/CMakeLists.txt:71 + test_dgpu_adapter_info.cc:18). 含完整 GPGPU compute path (PcieEndpointIP 1 PF + 16 VF + composite LL/PHY/Mux) + SDMA/CP/TMU/SQ/CQ + MemoryTLM 'vram' (BAR1 fast-path) + D-AXI 4 routing_enabled 字段 (per ADR-DGPU-10 anti-hijack root cause 4 + Change C.4 REVISED 终态). 4 routing_enabled 字段保留作 JSON anti-hijack barrier (per `f66070a8` C.4 REVISED 决策), 内部 flag 消费; 删 flag = BAR0 劫持 (per Metis `bg_fd20b1ed` A4 实证). NOT in D-AXI v1.8 4-IP topology scope (minimal_v1/timing_v1) — different role: 23 ABI driver-visible test config. Frozen public API: 23 ABI 签名零 diff (per ADR-DGPU-08).",
  "params": {
    "device_id": "0x1234",
    "quantum_cycles": 1000,
    "ptx_emu_root": "@PTX_EMU_ROOT@"
  },
  "display_routing_enabled": false,
  "storage_routing_enabled": true,
  "gmmu_routing_enabled": true,
  "memory_routing_enabled": true,
  "framebuffer_size_bytes": 268435456,
  "modules": [
    {
      "name": "soc",
      "type": "DGpuSoc",
      "connections": [],
      "modules": [
        {
          "name": "pcie_ep",
          "type": "PcieEndpointIP",
          "params": {
            "config_size": 4096,
            "num_msix_vectors": 16,
            "bar_sizes": [65536, 268435456],
            "bar0_registers": [
              {
                "offset": 0,
                "name": "GPU_REG_GPFIFO_PUT",
                "access": "rw"
              },
              {
                "offset": 20,
                "name": "GPU_REG_DOORBELL",
                "access": "wo",
                "side_effect": "doorbell"
              }
            ]
          }
        },
        {
          "name": "sdma",
          "type": "SdmaEngineTLM",
          "params": { "max_inflight": 4 }
        },
        {
          "name": "cp",
          "type": "CommandProcessorTLM"
        },
        {
          "name": "tmu",
          "type": "TmuDispatchProcessorTLM"
        },
        {
          "name": "sq",
          "type": "SubmitQueueTLM"
        },
        {
          "name": "cq",
          "type": "CompletionRingTLM"
        },
        {
          "name": "gpu",
          "type": "GpuCluster",
          "params": {
            "gpc_count": 2,
            "tpc_per_gpc": 2,
            "cu_per_tpc": 2,
            "cu_template": "configs/templates/compute_unit_v1.json"
          },
          "connections": []
        },
        {
          "name": "vram",
          "type": "MemoryTLM",
          "params": { "capacity_gb": 1 }
        }
      ],
      "connections": [
        { "src": "cp.fetch_out",     "dst": "vram.0" },
        { "src": "cp.dma_req",       "dst": "sdma.desc_in" },
        { "src": "cp.dispatch",      "dst": "tmu.dispatch_in" },
        { "src": "tmu.cta_out",      "dst": "sq.cta_in" },
        { "src": "sq.dispatch",      "dst": "gpu.cta_in" },
        { "src": "gpu.done",         "dst": "cq.done_in[0]" },
        { "src": "sdma.done_out",    "dst": "cq.done_in[1]" },
        { "src": "cq.done_out",      "dst": "tmu.done_in" },
        { "src": "gpu.done",         "dst": "sq.done_in[0]" }
      ],
      "outputs": [
        { "internal": "sdma.host_out",   "external": "host_dma" }
      ],
      "inputs": []
    }
  ],
  "connections": []
}
