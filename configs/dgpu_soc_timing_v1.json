{
  "name": "dgpu_soc_timing_v1",
  "description": "Timing-mode dGPU SoC v0.5 终态配置 (per openspec/changes/cpptlm-dgpu-soc-timing-mvp design.md §7 + ADR-DGPU-11 H2 互斥约束). 4 routing_enabled 字段保留 (per ADR-DGPU-10 anti-hijack root cause 4 + Change C.4 REVISED `f66070a8` 终态). simulation_mode=timing 字段保留 (timing-mode 必备). VramControllerTLM 替代 MemoryTLM (per H2 互斥, 沿用 minimal_v1 functional 拓扑 + 0 新增 connections). GMMU 不在 Crossbar 数据路径 (per M9). 5+ 套件 timing-mode E2E 闭环 (per test_dgpu_soc_timing_*.cc: init/inv/concurrent/d2h/h2d). 23 ABI 入口与 minimal_v1 共享. TLM StreamAdapter 连接 R-WIRE-1. D-AXI v2.0 目标: SoC 内部全 TLM 化.",
  "simulation_mode": "timing",
  "display_routing_enabled": false,
  "memory_routing_enabled": true,
  "storage_routing_enabled": true,
  "gmmu_routing_enabled": true,
  "framebuffer_size_bytes": 16777216,
  "modules": [
    {
      "name": "soc",
      "type": "DGpuSoc",
      "modules": [
        {
          "name": "pcie_ep",
          "type": "PcieEndpointIP",
          "params": {
            "config_size": 4096,
            "num_msix_vectors": 16,
            "bar_sizes": [4096, 16777216, 8589934592],
            "bar0_registers": [
              { "offset": 0,  "name": "GMMU_PT_BASE_LO", "access": "rw" },
              { "offset": 4,  "name": "GMMU_PT_BASE_HI", "access": "rw" },
              { "offset": 8,  "name": "GMMU_CTRL",      "access": "rw" },
              { "offset": 16, "name": "SDMA_STATUS",    "access": "ro" }
            ]
          }
        },
        {
          "name": "pcie_ctrl",
          "type": "PcieControllerIP",
          "params": {
            "bar_bases": [0, 16777216, 8589934592],
            "bar_sizes": [4096, 16777216, 8589934592],
            "link_speed_gts": 8
          }
        },
        {
          "name": "pcie_memory",
          "type": "PcieMemoryDevice",
          "params": { "capacity_gb": 8 }
        },
        {
          "name": "vram_ctrl",
          "type": "VramControllerTLM",
          "params": {
            "row_hit_cycles": 30,
            "row_miss_cycles": 80,
            "bandwidth_gbps": 32,
            "read_latency_hit_cycles": 30,
            "read_latency_miss_cycles": 80,
            "write_latency_cycles": 120,
            "use_zero_delay_for_test": false
          }
        },
        {
          "name": "sdma",
          "type": "SdmaEngineTLM",
          "params": { "max_inflight": 4 }
        },
        {
          "name": "gmmu",
          "type": "GmmuTLM",
          "params": { "page_size_bytes": 4096, "tlb_miss_latency_cycles": 50, "tlb_size": 32 }
        },
        {
          "name": "completion",
          "type": "CompletionRingTLM"
        }
      ],
      "connections": [
        { "src": "sdma.2", "dst": "pcie_memory.0", "latency": 1 },
        { "src": "gmmu.0", "dst": "pcie_memory.1", "latency": 1 }
      ]
    }
  ]
}
