{
  "name": "mesh_topology_tlm",
  "description": "2x2 Mesh NoC with TLM modules (CPUTLM + NICTLM + RouterTLM)",
  "modules": [
    {
      "name": "router_0_0",
      "type": "RouterTLM",
      "params": {
        "node_x": 0,
        "node_y": 0,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "router_0_1",
      "type": "RouterTLM",
      "params": {
        "node_x": 0,
        "node_y": 1,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "router_1_0",
      "type": "RouterTLM",
      "params": {
        "node_x": 1,
        "node_y": 0,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "router_1_1",
      "type": "RouterTLM",
      "params": {
        "node_x": 1,
        "node_y": 1,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "ni_0_0",
      "type": "NICTLM",
      "params": {
        "node_id": 0,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "ni_0_1",
      "type": "NICTLM",
      "params": {
        "node_id": 2,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "ni_1_0",
      "type": "NICTLM",
      "params": {
        "node_id": 1,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "ni_1_1",
      "type": "NICTLM",
      "params": {
        "node_id": 3,
        "mesh_x": 2,
        "mesh_y": 2
      }
    },
    {
      "name": "cpu_0_0",
      "type": "CPUTLM"
    },
    {
      "name": "cpu_0_1",
      "type": "CPUTLM"
    },
    {
      "name": "cpu_1_0",
      "type": "CPUTLM"
    },
    {
      "name": "cpu_1_1",
      "type": "CPUTLM"
    }
  ],
  "connections": [
    { "src": "router_0_0.2", "dst": "router_0_1.0", "latency": 1, "bandwidth": 100 },
    { "src": "router_0_0.1", "dst": "router_1_0.3", "latency": 1, "bandwidth": 100 },
    { "src": "router_0_0.4", "dst": "ni_0_0.1", "latency": 0, "bandwidth": 100 },
    { "src": "router_0_1.1", "dst": "router_1_1.3", "latency": 1, "bandwidth": 100 },
    { "src": "router_0_1.4", "dst": "ni_0_1.1", "latency": 0, "bandwidth": 100 },
    { "src": "router_1_0.2", "dst": "router_1_1.0", "latency": 1, "bandwidth": 100 },
    { "src": "router_1_0.4", "dst": "ni_1_0.1", "latency": 0, "bandwidth": 100 },
    { "src": "router_1_1.4", "dst": "ni_1_1.1", "latency": 0, "bandwidth": 100 },
    { "src": "ni_0_0.1", "dst": "router_0_0.4", "latency": 0, "bandwidth": 100 },
    { "src": "cpu_0_0", "dst": "ni_0_0.0", "latency": 1, "bandwidth": 100 },
    { "src": "ni_0_1.1", "dst": "router_0_1.4", "latency": 0, "bandwidth": 100 },
    { "src": "cpu_0_1", "dst": "ni_0_1.0", "latency": 1, "bandwidth": 100 },
    { "src": "ni_1_0.1", "dst": "router_1_0.4", "latency": 0, "bandwidth": 100 },
    { "src": "cpu_1_0", "dst": "ni_1_0.0", "latency": 1, "bandwidth": 100 },
    { "src": "ni_1_1.1", "dst": "router_1_1.4", "latency": 0, "bandwidth": 100 },
    { "src": "cpu_1_1", "dst": "ni_1_1.0", "latency": 1, "bandwidth": 100 },
    { "src": "ni_0_0.0", "dst": "cpu_0_0", "latency": 1, "bandwidth": 100 },
    { "src": "ni_0_1.0", "dst": "cpu_0_1", "latency": 1, "bandwidth": 100 },
    { "src": "ni_1_0.0", "dst": "cpu_1_0", "latency": 1, "bandwidth": 100 },
    { "src": "ni_1_1.0", "dst": "cpu_1_1", "latency": 1, "bandwidth": 100 }
  ]
