{
  "name": "dgpu_soc_minimal_v1",
  "description": "Minimal dGPU SoC v1.8 终态配置 (per openspec/changes/cpptlm-driver-visible-minimal-soc v1.8 P0 N1-N5 + ADR-DGPU-09 scope). 4 routing_enabled 字段保留 (per ADR-DGPU-10 anti-hijack root cause 4 + Change C.4 REVISED `f66070a8` 终态). DGpuBoard::load_soc_config (`dgpu_board_shell.cc:103-121`) 加载 4 flag 到 internal flag; JSON 字段删除 = BAR0 劫持 (per Metis `bg_fd20b1ed` A4 实证). framebuffer_size_bytes 顶层 (P0.5-landing) 派生 BAR1=16MB. 23 ABI 入口闭环测试 (per test_cpptlm_emulator_minimal_soc_smoke.cc 7 cases). TLM StreamAdapter 连接 R-WIRE-1 (per docs/designs/dgpu-soc/soc-internal-tlm-design-target.md §1.2). D-AXI v2.0 目标: SoC 内部全 TLM 化 (transport_dbg 接口).",
  "display_routing_enabled": false,
  "storage_routing_enabled": true,
  "gmmu_routing_enabled": true,
  "memory_routing_enabled": true,
  "framebuffer_size_bytes": 16777216,
  "simulation_mode": "functional",
  "modules": [
    {
      "name": "soc",
      "type": "DGpuSoc",
      "modules": [
        {
          "name": "vram_ctrl",
          "type": "VramControllerTLM",
          "params": {
            "operating_frequency_hz": 1000000000,
            "bandwidth_gbps": 32
          }
        },
        {
          "name": "pcie_ep",
          "type": "PcieEndpointIP",
          "params": {
            "config_size": 4096,
            "num_msix_vectors": 16,
            "bar_sizes": [4096, 16777216, 8589934592],
            "bar0_registers": [
              { "offset": 0,  "name": "GMMU_PT_BASE_LO", "access": "rw" },
              { "offset": 4,  "name": "GMMU_PT_BASE_HI", "access": "rw" },
              { "offset": 8,  "name": "GMMU_CTRL",      "access": "rw" },
              { "offset": 16, "name": "SDMA_STATUS",    "access": "ro" }
            ]
          }
        },
        {
          "name": "pcie_ctrl",
          "type": "PcieControllerIP",
          "params": {
            "bar_bases": [0, 16777216, 8589934592],
            "bar_sizes": [4096, 16777216, 8589934592],
            "link_speed_gts": 8
          }
        },
        {
          "name": "pcie_memory",
          "type": "PcieMemoryDevice",
          "params": { "capacity_gb": 8 }
        },
        {
          "name": "sdma",
          "type": "SdmaEngineTLM",
          "params": { "max_inflight": 4 }
        },
        {
          "name": "gmmu",
          "type": "GmmuTLM",
          "params": { "page_size_bytes": 4096 }
        },
        {
          "name": "completion",
          "type": "CompletionRingTLM"
        }
      ],
      "connections": [
        { "src": "sdma.2", "dst": "pcie_memory.0", "latency": 1 },
        { "src": "gmmu.0", "dst": "pcie_memory.1", "latency": 1 }
      ]
    }
  ]
}
