// configs/mesh_4x4.json
// 4×4 Mesh 测试拓扑：16 个 NICTLM + 16 个 Router
// 端口约定：NORTH=0, EAST=1, SOUTH=2, WEST=3, LOCAL=4
// XY 路由：先水平(X)后垂直(Y)
{
  "modules": [
    // 16 个 NIC，node_id 从 0 到 15，按 mesh 顺序排列
    { "name": "nic_0_0", "type": "NICTLM", "params": { "node_id": 0, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_1_0", "type": "NICTLM", "params": { "node_id": 1, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_2_0", "type": "NICTLM", "params": { "node_id": 2, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_3_0", "type": "NICTLM", "params": { "node_id": 3, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_0_1", "type": "NICTLM", "params": { "node_id": 4, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_1_1", "type": "NICTLM", "params": { "node_id": 5, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_2_1", "type": "NICTLM", "params": { "node_id": 6, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_3_1", "type": "NICTLM", "params": { "node_id": 7, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_0_2", "type": "NICTLM", "params": { "node_id": 8, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_1_2", "type": "NICTLM", "params": { "node_id": 9, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_2_2", "type": "NICTLM", "params": { "node_id": 10, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_3_2", "type": "NICTLM", "params": { "node_id": 11, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_0_3", "type": "NICTLM", "params": { "node_id": 12, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_1_3", "type": "NICTLM", "params": { "node_id": 13, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_2_3", "type": "NICTLM", "params": { "node_id": 14, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "nic_3_3", "type": "NICTLM", "params": { "node_id": 15, "mesh_x": 4, "mesh_y": 4 } },

    // 16 个 Router，node_x/node_y 从 0-3 x 0-3
    { "name": "router_0_0", "type": "RouterTLM", "params": { "node_x": 0, "node_y": 0, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_1_0", "type": "RouterTLM", "params": { "node_x": 1, "node_y": 0, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_2_0", "type": "RouterTLM", "params": { "node_x": 2, "node_y": 0, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_3_0", "type": "RouterTLM", "params": { "node_x": 3, "node_y": 0, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_0_1", "type": "RouterTLM", "params": { "node_x": 0, "node_y": 1, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_1_1", "type": "RouterTLM", "params": { "node_x": 1, "node_y": 1, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_2_1", "type": "RouterTLM", "params": { "node_x": 2, "node_y": 1, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_3_1", "type": "RouterTLM", "params": { "node_x": 3, "node_y": 1, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_0_2", "type": "RouterTLM", "params": { "node_x": 0, "node_y": 2, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_1_2", "type": "RouterTLM", "params": { "node_x": 1, "node_y": 2, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_2_2", "type": "RouterTLM", "params": { "node_x": 2, "node_y": 2, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_3_2", "type": "RouterTLM", "params": { "node_x": 3, "node_y": 2, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_0_3", "type": "RouterTLM", "params": { "node_x": 0, "node_y": 3, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_1_3", "type": "RouterTLM", "params": { "node_x": 1, "node_y": 3, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_2_3", "type": "RouterTLM", "params": { "node_x": 2, "node_y": 3, "mesh_x": 4, "mesh_y": 4 } },
    { "name": "router_3_3", "type": "RouterTLM", "params": { "node_x": 3, "node_y": 3, "mesh_x": 4, "mesh_y": 4 } }
  ],
  "groups": {
    "nics": ["nic_*"],
    "routers": ["router_*"]
  },
  "connections": [
    // NIC → Router (Local 端口，端口索引 4)
    { "src": "nic_0_0", "dst": "router_0_0.4", "latency": 1 },
    { "src": "nic_1_0", "dst": "router_1_0.4", "latency": 1 },
    { "src": "nic_2_0", "dst": "router_2_0.4", "latency": 1 },
    { "src": "nic_3_0", "dst": "router_3_0.4", "latency": 1 },
    { "src": "nic_0_1", "dst": "router_0_1.4", "latency": 1 },
    { "src": "nic_1_1", "dst": "router_1_1.4", "latency": 1 },
    { "src": "nic_2_1", "dst": "router_2_1.4", "latency": 1 },
    { "src": "nic_3_1", "dst": "router_3_1.4", "latency": 1 },
    { "src": "nic_0_2", "dst": "router_0_2.4", "latency": 1 },
    { "src": "nic_1_2", "dst": "router_1_2.4", "latency": 1 },
    { "src": "nic_2_2", "dst": "router_2_2.4", "latency": 1 },
    { "src": "nic_3_2", "dst": "router_3_2.4", "latency": 1 },
    { "src": "nic_0_3", "dst": "router_0_3.4", "latency": 1 },
    { "src": "nic_1_3", "dst": "router_1_3.4", "latency": 1 },
    { "src": "nic_2_3", "dst": "router_2_3.4", "latency": 1 },
    { "src": "nic_3_3", "dst": "router_3_3.4", "latency": 1 },

    // Router → Router (网格连接)
    // 端口约定：NORTH=0, EAST=1, SOUTH=2, WEST=3
    // 连接方向：src 的出口连接 dst 的对面入口

    // ========== 水平连接 (X 方向) ==========
    // Row 0 (y=0): router_x_0 EAST <-> router_{x+1}_0 WEST
    { "src": "router_0_0.1", "dst": "router_1_0.3", "latency": 1 },
    { "src": "router_1_0.1", "dst": "router_2_0.3", "latency": 1 },
    { "src": "router_2_0.1", "dst": "router_3_0.3", "latency": 1 },
    // Row 1 (y=1): router_x_1 EAST <-> router_{x+1}_1 WEST
    { "src": "router_0_1.1", "dst": "router_1_1.3", "latency": 1 },
    { "src": "router_1_1.1", "dst": "router_2_1.3", "latency": 1 },
    { "src": "router_2_1.1", "dst": "router_3_1.3", "latency": 1 },
    // Row 2 (y=2): router_x_2 EAST <-> router_{x+1}_2 WEST
    { "src": "router_0_2.1", "dst": "router_1_2.3", "latency": 1 },
    { "src": "router_1_2.1", "dst": "router_2_2.3", "latency": 1 },
    { "src": "router_2_2.1", "dst": "router_3_2.3", "latency": 1 },
    // Row 3 (y=3): router_x_3 EAST <-> router_{x+1}_3 WEST
    { "src": "router_0_3.1", "dst": "router_1_3.3", "latency": 1 },
    { "src": "router_1_3.1", "dst": "router_2_3.3", "latency": 1 },
    { "src": "router_2_3.1", "dst": "router_3_3.3", "latency": 1 },

    // ========== 垂直连接 (Y 方向) ==========
    // Col 0 (x=0): router_0_y SOUTH <-> router_0_{y+1} NORTH
    { "src": "router_0_0.2", "dst": "router_0_1.0", "latency": 1 },
    { "src": "router_0_1.2", "dst": "router_0_2.0", "latency": 1 },
    { "src": "router_0_2.2", "dst": "router_0_3.0", "latency": 1 },
    // Col 1 (x=1): router_1_y SOUTH <-> router_1_{y+1} NORTH
    { "src": "router_1_0.2", "dst": "router_1_1.0", "latency": 1 },
    { "src": "router_1_1.2", "dst": "router_1_2.0", "latency": 1 },
    { "src": "router_1_2.2", "dst": "router_1_3.0", "latency": 1 },
    // Col 2 (x=2): router_2_y SOUTH <-> router_2_{y+1} NORTH
    { "src": "router_2_0.2", "dst": "router_2_1.0", "latency": 1 },
    { "src": "router_2_1.2", "dst": "router_2_2.0", "latency": 1 },
    { "src": "router_2_2.2", "dst": "router_2_3.0", "latency": 1 },
    // Col 3 (x=3): router_3_y SOUTH <-> router_3_{y+1} NORTH
    { "src": "router_3_0.2", "dst": "router_3_1.0", "latency": 1 },
    { "src": "router_3_1.2", "dst": "router_3_2.0", "latency": 1 },
    { "src": "router_3_2.2", "dst": "router_3_3.0", "latency": 1 }
  ]
}
