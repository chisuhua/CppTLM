        ]
      },
      {
        "name": "cluster1",
        "description": "CPU Cluster 1 with shared L2",
        "children": [
          {"name": "cpu2", "coherence_domain": "cluster1_l2"},
          {"name": "cpu3", "coherence_domain": "cluster1_l2"},
          {"name": "l2_1", "coherence_domain": "cluster1_l2"}
        ]
      },
      {
        "name": "fabric",
        "children": [
          {"name": "xbar"}
        ]
      },
      {
        "name": "memory_subsystem",
        "children": [
          {"name": "mem0"},
          {"name": "mem1"}
        ]
      }
