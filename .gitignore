# ===== ⚠️ DO NOT `git add build/` — 仅 `git add <source> <test> <config>` =====
# 历史教训: commit 4d2f238 (`fix(pcie-phy): Oracle C3/C4/C5`) 不小心 `git add .`
# 把整个 build/ 目录 (~500 MB) 加入 git,迫使清理 commit。本次强化 .gitignore
# 防止再次发生。CMake 输出永远是 noise,不在 review 范围,不应进 git。
# CMake build (用 / 前缀只匹配仓库根的 build/ 目录,不影响 scripts/build/)
build/
build-*/
build_*/
cmake-build*/
cmake-build-*/
*.o
*.a
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Checkpoint files
*.checkpoint.*.jsonl
*.jsonl.reset.*
*,

# Test
ctest_results/

__pycache__/

# Simulation artifacts
configs.bak1/
configs/common/
output/
output/*.jsonl
output/*.dot
output/*.json
topology.dot
build_asan/
build-debug/
build_baseline/
build_rtl/

# Example configurations
configs/single_cluster_soc.*
configs/soc_cluster_*.json
configs/soc_cluster_a_annotated.*
configs/soc_cluster_b_annotated.*

# Editor dependencies
cpptlm/visualization/editor/node_modules/
openspec/changes/archive/

# Sisyphus planning files
.sisyphus/

# OpenCode metadata
.omo/

# Python test cache
.pytest_cache/
# Added by code-review-graph
.code-review-graph/
# Added by understand-anything tool
.understand-anything/

# Phase 0.5 baseline worktrees (isolated workspace per .opencode/skills/using-git-worktrees)
.worktrees/
lib/

# PTX-EMU integration build dirs (per scripts/build/build_ptx_emu.sh)
#   build-on/  = CPPTLM_WITH_PTX_EMU=ON  (PTX-EMU submodule linked)
#   build-off/ = CPPTLM_WITH_PTX_EMU=OFF (default; PTX-EMU not built)
#   Both are heavy (1-2 GB each), regenerated on demand, never tracked.
build-on/
build-off/

# Temporary test scratch dirs (e.g. `Testing/` from CTest/Catch2)
Testing/

# Roadmap migrate backups (transient; produced by rddf roadmap migrate).
#   Each backup dir is timestamped (.rddf/.roadmap-migrate-backup-<TS>/)
.rddf/.roadmap-migrate-backup-*/
