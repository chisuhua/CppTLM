{
  "schema": "cep-b3b2-d4-probe/v1",
  "note": "`B3b-2` 受限族的 **D-4 触发探测清单**(4 族 × 2 路径 = 8 槽位)。⚠️ **枚举单位 = source event**(CXL 2.0 / 3.0 共享同一联盟许可事件 ⇒ 挂 family_effect[],⛔ 不重复检索)。⚠️ **②「人类成员条款摘要」不是外部检索** ⇒ check_type=internal_artifact(闸直接扫仓内文件)。⛔ 本清单**不改动**任何 DoD 计数(B3b-2 仍 0/4)⇒ 命中只触发**重判**,⛔ 不直接改计数(per 07 号 D-2 双轴:触发轴 T1-T4 ∧ 交付轴 引擎+L4 E2E)。",
  "key_whitelist": {
    "probe": ["id", "family", "path", "check_type", "source_event_id", "family_effect", "search_goal", "search_sources", "artifact_glob", "signer_fields", "must_all", "on_hit", "deferral_trigger_sha256"],
    "source": ["host", "url", "page_type", "title_hint"],
    "criterion": ["field", "op", "value"]
  },
  "allowed_page_types": [
    "official_announcement",
    "download_index",
    "version_list",
    "license_page",
    "member_portal"
  ],
  "forbidden_url_patterns": [
    "\\.pdf(\\?|$)",
    "/sites/default/files/",
    "/wp-content/uploads/"
  ],
  "banned_tokens": [
    "视情况",
    "酌情",
    "确认可读",
    "适当",
    "必要时",
    "已确认",
    "相关"
  ],
  "result_states": ["hit", "miss", "unknown"],
  "unknown_reasons": [
    "site_unreachable",
    "login_wall",
    "redirect_to_pdf",
    "archive_snapshot_only",
    "auto_body_contact"
  ],
  "source_events": [
    {
      "source_event_id": "cxl-3.x-spec-license",
      "note": "CXL 2.0 与 3.0 **共享**该事件(同一联盟 / 同一许可页)⇒ 一次变更同时影响两族"
    },
    {
      "source_event_id": "nvlink-clause-level-doc",
